[Unit]
Description=Jules Swarm Orchestrator Daemon (Watcher)
After=network.target

[Service]
User=misi
WorkingDirectory=/home/misi/Jules_mx/Swarm_Control_Center
ExecStart=/usr/bin/python3 /home/misi/Jules_mx/Swarm_Control_Center/swarm_orchestrator.py
Restart=always
RestartSec=5
# Output logs to standard journald
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
